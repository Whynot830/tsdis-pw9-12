# Скопируйте в practice2/.env:  cp .env.example .env
# Не коммитьте .env в git.

# --- PostgreSQL ---
# Не добавляйте сюда DATABASE_URL с 127.0.0.1: Docker Compose подставляет переменные из этого файла в YAML,
# и тогда gateway в контейнере получал бы localhost вместо сервиса «postgres».
# Для drizzle-kit push / npm run db:push с хоста выполните в терминале, например:
#   export DATABASE_URL=postgresql://finances:finances@127.0.0.1:5432/finances

INTERNAL_API_TOKEN=dev-internal-token-change-me
BETTER_AUTH_SECRET=dev-better-auth-secret-min-32-chars-long!!

# --- Google OAuth (better-auth в gateway) ---
# В Google Cloud Console → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# (для vite dev с портом 5173 используйте тот же путь на этом origin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram Bot API (worker: уведомления о бюджете) ---
# Создание: Telegram → @BotFather → /newbot → скопировать токен.
TELEGRAM_BOT_TOKEN=

# chat_id пользователя кладётся в БД: user_notification_settings.telegram_chat_id
# Узнать id: написать боту, затем GET https://api.telegram.org/bot<TOKEN>/getUpdates

# --- pgAdmin (опционально, см. README) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
# PGADMIN_PORT=5050
