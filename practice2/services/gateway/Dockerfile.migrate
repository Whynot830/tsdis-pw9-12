# Образ для одноразового Job в Kubernetes: drizzle-kit push (см. practice3/k8s).
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY drizzle.config.ts ./
COPY src/lib/server/db ./src/lib/server/db

ENV CI=true
CMD ["npx", "drizzle-kit", "push", "--force"]
