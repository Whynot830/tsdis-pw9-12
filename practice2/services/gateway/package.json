{
  "name": "whynot-finances-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:prod": "DATABASE_URL=${DATABASE_URL:-postgresql://build:build@127.0.0.1:5432/build} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-build-build-build-build-build-build-secret-32chars-min} ORIGIN=${ORIGIN:-http://localhost:3000} vite build",
    "vercel-build": "npm run db:push && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && git config core.hooksPath .git-hooks || echo 'Not in a git repo'",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write . --log-level warn --ignore-path .gitignore",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "eslint --fix",
    "lint:debug": "eslint --debug",
    "pre-commit": "npm run lint:fix && npm run format && tsc",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@internationalized/date": "^3.11.0",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/table-core": "^8.21.3",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24",
    "@vite-pwa/sveltekit": "^1.1.0",
    "better-auth": "^1.4.18",
    "bits-ui": "^2.16.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-svelte": "^3.14.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "formsnap": "^2.0.1",
    "globals": "^17.3.0",
    "layerchart": "^2.0.0-next.43",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "svelte-sonner": "^1.0.7",
    "sveltekit-superforms": "^2.30.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.4",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.0",
    "@tanstack/svelte-virtual": "^3.13.21",
    "fuse.js": "^7.1.0",
    "postgres": "^3.4.8",
    "valibot": "^1.2.0"
  }
}
