# Локальный запуск: скопируйте в .env в ЭТОЙ папке (gateway).
# Postgres должен быть доступен (например: docker compose up -d postgres в practice2/).

DATABASE_URL=postgresql://finances:finances@127.0.0.1:5432/finances

# Обязательно совпадает с URL в браузере при npm run dev (обычно порт 5173).
ORIGIN=http://localhost:5173

BETTER_AUTH_SECRET=минимум-32-символа-случайная-строка

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# В Google Console → Authorized redirect URIs добавьте:
#   http://localhost:5173/api/auth/callback/google

# Опционально GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Для вызова worker при создании транзакции (можно оставить пустым при отладке только логина)
# WORKER_INTERNAL_URL=http://127.0.0.1:3001
# INTERNAL_API_TOKEN=dev-internal-token-change-me
